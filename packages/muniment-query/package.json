{
  "name": "muniment-query",
  "version": "0.1.1",
  "description": "Typed reader, schema validators and renewal verification for the Muniment archive on Arkiv (Tiramisu testnet).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@arkiv-network/sdk": "~0.8.1",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.7"
  }
}
